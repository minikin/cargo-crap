{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/minikin/cargo-crap/main/schemas/crapts/report-v1.json",
  "title": "crapts absolute report (v1)",
  "description": "Wire format produced by crapts --format json without --baseline.",
  "type": "object",
  "required": [
    "version",
    "name_scheme",
    "coverage_kind",
    "threshold",
    "selection",
    "notices",
    "summary",
    "entries",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URL of the JSON Schema this document conforms to."
    },
    "version": {
      "$ref": "#/definitions/SemVer",
      "description": "Tool version that produced this report."
    },
    "name_scheme": {
      "type": "integer",
      "const": 1,
      "description": "Function naming scheme version."
    },
    "coverage_kind": {
      "type": "string",
      "enum": ["statements", "lines"],
      "description": "Measured coverage unit."
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "description": "CRAP threshold above which a function counts as crappy."
    },
    "selection": {
      "$ref": "#/definitions/Selection",
      "description": "Effective display slice, or null when unsliced."
    },
    "notices": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered diagnostics attached to this report."
    },
    "summary": {
      "$ref": "#/definitions/Summary",
      "description": "Full-population summary counts."
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/CrapEntry" },
      "description": "Shown current function rows."
    },
    "changed": {
      "type": "object",
      "description": "Optional changed-function section payload."
    },
    "diagnostics": {
      "$ref": "#/definitions/ScopeDiagnostics",
      "description": "Source and coverage scope overlap."
    }
  },
  "definitions": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$"
    },
    "Selection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["top", "min"],
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "min": {
              "type": ["number", "null"]
            }
          },
          "anyOf": [
            { "properties": { "top": { "type": "integer", "minimum": 1 } } },
            { "properties": { "min": { "type": "number" } } }
          ]
        }
      ]
    },
    "Summary": {
      "type": "object",
      "required": [
        "total",
        "crappy",
        "regressed",
        "improved",
        "new",
        "moved",
        "unchanged",
        "removed",
        "changed_failures"
      ],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "crappy": { "type": "integer", "minimum": 0 },
        "regressed": { "type": "null" },
        "improved": { "type": "null" },
        "new": { "type": "null" },
        "moved": { "type": "null" },
        "unchanged": { "type": "null" },
        "removed": { "type": "null" },
        "changed_failures": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "CrapEntry": {
      "type": "object",
      "required": ["file", "function", "line", "cyclomatic", "coverage", "crap"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^([^./\\\\]|\\.[^/\\\\])[^\\\\]*$",
          "not": { "pattern": "^[A-Za-z]:" },
          "description": "Cwd-relative, slash-separated source file path with no leading ./."
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "cyclomatic": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "crap": {
          "type": "number",
          "minimum": 1
        },
        "uncovered": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/LineRange" }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "LineRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "ScopeDiagnostics": {
      "type": "object",
      "required": [
        "analyzed_files",
        "coverage_files",
        "matched_files",
        "source_only",
        "coverage_only"
      ],
      "additionalProperties": false,
      "properties": {
        "analyzed_files": { "type": "integer", "minimum": 0 },
        "coverage_files": { "type": "integer", "minimum": 0 },
        "matched_files": { "type": "integer", "minimum": 0 },
        "source_only": { "$ref": "#/definitions/StrayFiles" },
        "coverage_only": { "$ref": "#/definitions/StrayFiles" }
      }
    },
    "StrayFiles": {
      "type": "object",
      "required": ["count", "examples"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "examples": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string" }
        }
      }
    }
  }
}
